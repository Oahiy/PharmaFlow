# 这里的数据库地址对应 docker-compose.yml 的本地开发服务。
DATABASE_URL=postgresql://pharmaflow:pharmaflow@127.0.0.1:5432/pharmaflow
LANGGRAPH_STRICT_MSGPACK=true

LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-v4-pro
# DeepSeek 始终关闭 thinking。此开关适用于接受 DeepSeek thinking 参数格式的端点。
LLM_DISABLE_THINKING=false

# API 和正式评测使用同一个 Langfuse Cloud 项目的凭据。
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# 打包时可通过 Langfuse SDK 的 release 变量提供构建对应的 Git commit。
# LANGFUSE_RELEASE=
# API 可显式关闭追踪。正式评测要求开启。
LANGFUSE_TRACING_ENABLED=true

# chem-mcp 使用本地 RDKit 和 data/ 下的 CSV，可直接以 stdio 启动。
# Agent 为两个 stdio 子进程显式提供 PATH 和项目根目录作为 PYTHONPATH。
# API 和 chem-mcp 共用上传目录。相对路径基于项目根目录；内置 candidates 仍在 data/。
UPLOAD_DIR=data/uploads
# 每个文件的字节数上限（默认 5 MiB）和数据行数上限（不含表头）。
MAX_UPLOAD_BYTES=5242880
MAX_UPLOAD_ROWS=5000

# Streamlit 访问 FastAPI 的服务地址。
API_BASE_URL=http://127.0.0.1:8000

# lit-mcp 的 stdio 子进程需要显式传入这些变量。
# 模式可选 live、record、replay。相对录制目录以项目根目录为基准。
LIT_MCP_MODE=replay
LIT_MCP_RECORDINGS_DIR=data/lit_recordings
NCBI_API_KEY=

# lit-mcp 的检索索引地址和模型缓存。相对缓存路径基于项目根目录。
QDRANT_URL=http://127.0.0.1:6333
FASTEMBED_CACHE_PATH=.cache/fastembed
